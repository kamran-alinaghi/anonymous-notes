{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "verify": "npm test && npm run typecheck && npm run build",
    "kam-run": "npm run verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Anonymous Note TypeScript backend",
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
