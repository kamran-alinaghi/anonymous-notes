# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Comma-separated browser origins allowed to open /ws.
# Requests without an Origin header (for non-browser clients) are permitted.
ALLOWED_ORIGINS=http://localhost:5173

# Per-process WebSocket limits.
MAX_WS_CONNECTIONS=1000
MAX_WS_MESSAGES_PER_MINUTE=120
MAX_WS_MESSAGE_BYTES=262144
